{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": [
      "ES2024"
    ],
    "types": [
      "bun"
    ],
    "outDir": "node_modules/.cache/build-types",
    "tsBuildInfoFile": "node_modules/.cache/build.tsbuildinfo"
  },
  "include": [
    "vite.config.ts"
  ]
}
